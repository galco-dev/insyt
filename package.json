{
  "name": "insyt",
  "private": true,
  "version": "0.1.0",
  "description": "Insyt — Google Ads, Analytics and Tag Manager, checked and fixed weekly with customer approval.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "node --test \"packages/**/test/*.test.js\" \"apps/**/test/*.test.js\"",
    "build:client": "node apps/web/client/scripts/decode-assets.js && vite build apps/web/client",
    "start:web": "node apps/web/src/main.js",
    "start:worker": "node apps/worker/src/main.js",
    "start:poller": "node apps/poller/src/main.js",
    "start:cron": "node apps/cron/src/main.js",
    "lint:jargon": "node scripts/jargon-lint.js",
    "crawl": "node packages/crawler/cli.js",
    "smoke": "node scripts/smoke.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "bullmq": "^5.34.0",
    "playwright": "^1.49.0"
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.3",
    "@react-aria/utils": "^3.34.1",
    "@react-stately/utils": "^3.12.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.2",
    "@untitledui/icons": "^0.0.22",
    "@vitejs/plugin-react": "^6.0.5",
    "clsx": "^2.1.1",
    "motion": "^12.43.0",
    "react": "^19.2.8",
    "react-aria": "^3.51.0",
    "react-aria-components": "^1.20.0",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.2.2",
    "tailwindcss-animate": "^1.0.7",
    "tailwindcss-react-aria-components": "^2.0.1",
    "vite": "^8.2.1"
  }
}
