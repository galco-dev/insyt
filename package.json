{
  "name": "insyt",
  "private": true,
  "version": "0.1.0",
  "description": "Insyt — Google Ads, Analytics and Tag Manager, checked and fixed weekly with customer approval.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "node --test \"packages/**/test/*.test.js\" \"apps/**/test/*.test.js\"",
    "start:web": "node apps/web/src/main.js",
    "start:worker": "node apps/worker/src/service.js",
    "start:poller": "node apps/poller/src/service.js",
    "start:cron": "node apps/cron/src/service.js",
    "lint:jargon": "node scripts/jargon-lint.js",
    "crawl": "node packages/crawler/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "playwright": "^1.49.0"
  }
}
